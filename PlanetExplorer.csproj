<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Textures\earth.jpg" />
    <None Remove="Assets\Textures\jupiter.jpg" />
    <None Remove="Assets\Textures\mars.jpg" />
    <None Remove="Assets\Textures\mercury.jpg" />
    <None Remove="Assets\Textures\neptune.jpg" />
    <None Remove="Assets\Textures\saturn.jpg" />
    <None Remove="Assets\Textures\saturn_rings.png" />
    <None Remove="Assets\Textures\stars.jpg" />
    <None Remove="Assets\Textures\sun.jpg" />
    <None Remove="Assets\Textures\uranus.jpg" />
    <None Remove="Assets\Textures\uranus_rings.jpg" />
    <None Remove="Assets\Textures\venus.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.24">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Textures\earth.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\jupiter.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\mars.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\mercury.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\neptune.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\saturn.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\saturn_rings.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Textures\stars.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
