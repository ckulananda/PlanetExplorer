<Window x:Class="PlanetExplorer.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F12">

    <Window.Resources>

        <!-- ========= THEME ========= -->
        <SolidColorBrush x:Key="BgWindow" Color="#0F0F12"/>
        <SolidColorBrush x:Key="BgPanel" Color="#181A20"/>
        <SolidColorBrush x:Key="BgCard"  Color="#12131A"/>
        <SolidColorBrush x:Key="BgInput" Color="#22252D"/>
        <SolidColorBrush x:Key="BgSoft"  Color="#1C1F27"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#BDBDBD"/>
        <SolidColorBrush x:Key="Accent"      Color="#6CC4FF"/>

        <!-- ========= COMMON STYLES ========= -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="ComboStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>

        <Style TargetType="ListBox" x:Key="ListStyle">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button" x:Key="BtnStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryBtnStyle" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0F0F12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: USER LIST ================= -->
        <Border Grid.Column="0"
                Background="{StaticResource BgPanel}"
                CornerRadius="14"
                Padding="14"
                Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Users"
                               Foreground="{StaticResource Accent}"
                               FontSize="20"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="Manage ; Select"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="10,2,0,0"/>
                </DockPanel>

                <!-- Search + filter -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource InputStyle}"
                             Width="Auto"
                             HorizontalAlignment="Stretch"
                             Text=""/>

                    <CheckBox x:Name="ShowInactiveCheck"
                              Content="Show inactive users"
                              Foreground="{StaticResource TextMuted}"
                              Margin="2,10,0,0"/>
                </StackPanel>

                <!-- Users list -->
                <ListBox x:Name="UsersList"
                         Grid.Row="2"
                         Style="{StaticResource ListStyle}"
                         DisplayMemberPath="FullName"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button x:Name="SelectUserButton"
                            Content="Select"
                            Width="110"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Click="SelectUser_Click"/>
                    <Button x:Name="NewUserButton"
                            Content="New User"
                            Width="110"
                            Style="{StaticResource BtnStyle}"
                            Click="NewUser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= RIGHT: DETAILS ================= -->
        <Border Grid.Column="1"
                Background="{StaticResource BgPanel}"
                CornerRadius="14"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= Header ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Profile"
                                   Foreground="{StaticResource Accent}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ElementName=NameBox, Path=Text}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <Border Margin="10,2,0,0"
                                    Padding="10,3"
                                    CornerRadius="999"
                                    Background="#233142">
                                <TextBlock Text="Active"
                                           Foreground="{StaticResource Accent}"
                                           FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="HeaderSaveButton"
                            Content="Save"
                            Width="110"
                            Margin="0,0,10,0"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Click="Save_Click"/>

                    <Button Grid.Column="2"
                            x:Name="HeaderDeleteButton"
                            Content="Delete"
                            Width="110"
                            Style="{StaticResource BtnStyle}"
                            Click="Delete_Click"/>
                </Grid>

                <!-- ================= Scroll content ================= -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== Top section: picture + form ===== -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Picture card -->
                            <Border Style="{StaticResource CardBorder}"
                                    Margin="0,0,14,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="180"
                                            Height="180"
                                            CornerRadius="999"
                                            Background="{StaticResource BgInput}"
                                            ClipToBounds="True">
                                        <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock x:Name="PicHintText"
                                               Text="No picture selected"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"/>

                                    <Button Content="Choose Picture"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource BtnStyle}"
                                            Click="ChoosePicture_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Form card -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="Full Name" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Age" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="AgeBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="Location" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="LocationBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Phone" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="PhoneBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="EmailBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="Job Type" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="JobBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,10">
                                        <CheckBox x:Name="IsActiveCheck"
                                                  Content="Active"
                                                  Foreground="{StaticResource TextMuted}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="Delete Mode" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="DeleteModeCombo"
                                                  Style="{StaticResource ComboStyle}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Soft Delete" Tag="soft"/>
                                            <ComboBoxItem Content="Hard Delete" Tag="hard"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Border Grid.Row="4" Grid.ColumnSpan="2"
                                            Background="{StaticResource BgSoft}"
                                            CornerRadius="12"
                                            Padding="10"
                                            Margin="0,4,0,0">
                                        <TextBlock x:Name="StatusText"
                                                   Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== Stats section ===== -->
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Background="{StaticResource BgCard}"
                                CornerRadius="14"
                                Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Quiz Statistics"
                                           Foreground="{StaticResource Accent}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Margin="0,0,0,12"/>

                                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                                    <Border Background="{StaticResource BgSoft}" CornerRadius="12" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Overview" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <TextBlock x:Name="StatSummaryText"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="14"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BgSoft}" CornerRadius="12" Padding="12" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Best Streak" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <!-- ✅ FIX: add x:Name -->
                                            <TextBlock x:Name="BestStreakText"
                                                       Text="—"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BgSoft}" CornerRadius="12" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Last Quiz" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                            <!-- ✅ FIX: add x:Name -->
                                            <TextBlock x:Name="LastQuizText"
                                                       Text="—"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Header="Quiz History"
                                              Foreground="{StaticResource TextPrimary}"
                                              Margin="0,0,12,0">
                                        <ListBox x:Name="QuizHistoryList"
                                                 Style="{StaticResource ListStyle}"
                                                 Height="170"/>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                              Header="Most Missed Questions"
                                              Foreground="{StaticResource TextPrimary}">
                                        <ListBox x:Name="WrongQuestionsList"
                                                 Style="{StaticResource ListStyle}"
                                                 Height="170"/>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>

                <!-- ================= Bottom bar ================= -->
                <Border Grid.Row="2"
                        Background="#12131A"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Tip: Use the search to quickly find users. Stats stay visible below."
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Save"
                                Width="120"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Click="Save_Click"/>

                        <Button Grid.Column="2"
                                Content="Delete"
                                Width="120"
                                Style="{StaticResource BtnStyle}"
                                Click="Delete_Click"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
