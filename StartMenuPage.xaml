<Page x:Class="PlanetExplorer.StartMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#10131A">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <TextBlock Text="Start Menu"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Height="44" Margin="0,6" Content="▶ Start Exploration" Click="StartExploration_Click"/>
            <Button Height="44" Margin="0,6" Content="👤 Profile" Click="Profile_Click"/>
            <Button Height="44" Margin="0,6" Content="📊 Progress / Statistics" Click="Progress_Click"/>
            <Button Height="44" Margin="0,6" Content="⚙ Settings" Click="Settings_Click"/>
            <Button Height="44" Margin="0,6" Content="ℹ About Application" Click="About_Click"/>
            <Button Height="44" Margin="0,16,0,0" Content="❌ Exit" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Page>
