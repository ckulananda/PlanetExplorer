<Page x:Class="PlanetExplorer.LoadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Black">

    <Grid>
        <!-- Stars background -->
        <Canvas x:Name="StarCanvas" />

        <!-- Light speed streaks -->
        <Canvas x:Name="StreakCanvas" IsHitTestVisible="False" />

        <!-- Center title -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PlanetExplorer"
                       Foreground="White"
                       FontSize="44"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Welcome to the Universe"
                       Foreground="#BFD7FF"
                       FontSize="16"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="StatusText"
                       Text="Loading resources..."
                       Foreground="#C9C9C9"
                       FontSize="14"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Bottom loading bar -->
        <Border VerticalAlignment="Bottom" Height="90" Background="#33000000">
            <StackPanel Margin="20">
                <ProgressBar x:Name="LoadBar" Height="14" Minimum="0" Maximum="100"
                             Value="0" />

                <TextBlock x:Name="StepText"
                           Margin="0,10,0,0"
                           Foreground="#E6E6E6"
                           FontSize="13"
                           Text="Initializing..."
                           />
            </StackPanel>
        </Border>
    </Grid>
</Page>
